{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://attest-it.dev/schemas/config.schema.json",
  "title": "attest-it Operational Configuration",
  "description": "Operational configuration schema for attest-it. Contains suite definitions and command execution settings.",
  "$ref": "#/definitions/config",
  "definitions": {
    "config": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "settings": {
          "type": "object",
          "properties": {
            "defaultCommand": {
              "type": "string"
            },
            "keyProvider": {
              "type": "object",
              "properties": {
                "type": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["filesystem", "1password"]
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "privateKeyPath": {
                      "type": "string"
                    },
                    "account": {
                      "type": "string"
                    },
                    "vault": {
                      "type": "string"
                    },
                    "itemName": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "required": ["type"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "suites": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "gate": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ignore": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "command": {
                "type": "string"
              },
              "timeout": {
                "type": "string"
              },
              "interactive": {
                "type": "boolean"
              },
              "invalidates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": ["version", "suites"],
      "additionalProperties": false
    }
  }
}
