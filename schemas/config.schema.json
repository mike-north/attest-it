{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://attest-it.dev/schemas/config.schema.json",
  "title": "attest-it Configuration",
  "description": "Configuration file schema for the attest-it testing attestation framework",
  "type": "object",
  "required": ["version", "suites"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Configuration schema version"
    },
    "settings": {
      "type": "object",
      "description": "Global settings for attestation behavior",
      "properties": {
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Maximum age in days before an attestation expires"
        },
        "publicKeyPath": {
          "type": "string",
          "default": ".attest-it/pubkey.pem",
          "description": "Path to the public key file used for signature verification"
        },
        "attestationsPath": {
          "type": "string",
          "default": ".attest-it/attestations.json",
          "description": "Path to the attestations file"
        },
        "defaultCommand": {
          "type": "string",
          "description": "Default command to execute for attestation (can be overridden per suite)"
        },
        "algorithm": {
          "type": "string",
          "enum": ["ed25519", "rsa"],
          "default": "ed25519",
          "description": "Cryptographic algorithm to use for signatures"
        },
        "keyProvider": {
          "type": "object",
          "description": "Configuration for the key storage provider",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["filesystem", "1password", "macos-keychain"],
              "description": "Key provider type"
            },
            "options": {
              "type": "object",
              "description": "Provider-specific options",
              "properties": {
                "privateKeyPath": {
                  "type": "string",
                  "description": "Path to private key file (filesystem provider)"
                },
                "account": {
                  "type": "string",
                  "description": "1Password account email or ID"
                },
                "vault": {
                  "type": "string",
                  "description": "1Password vault name"
                },
                "itemName": {
                  "type": "string",
                  "description": "1Password item name for the private key"
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "suites": {
      "type": "object",
      "description": "Named test suites with their configurations",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/suite"
      }
    }
  },
  "definitions": {
    "suite": {
      "type": "object",
      "description": "Configuration for a single test suite",
      "required": ["packages"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of what this suite tests"
        },
        "packages": {
          "type": "array",
          "description": "Glob patterns for npm packages to include in fingerprint",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "files": {
          "type": "array",
          "description": "Additional file patterns to include in fingerprint",
          "items": {
            "type": "string"
          }
        },
        "ignore": {
          "type": "array",
          "description": "Patterns to ignore when computing fingerprint",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string",
          "description": "Command to execute for this suite (overrides defaultCommand)"
        },
        "invalidates": {
          "type": "array",
          "description": "Other suite names that, when changed, invalidate this suite's attestation",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
