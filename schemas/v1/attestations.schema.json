{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://attest-it.dev/schemas/attestations.schema.json",
  "title": "attest-it Attestations",
  "type": "object",
  "required": ["schemaVersion", "attestations", "signature"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "attestations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/attestation"
      }
    },
    "signature": {
      "type": "string",
      "description": "Base64-encoded signature over canonical attestations array"
    }
  },
  "definitions": {
    "attestation": {
      "type": "object",
      "required": ["suite", "fingerprint", "attestedAt", "attestedBy", "command", "exitCode"],
      "properties": {
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "attestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "attestedBy": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "type": "integer",
          "const": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
