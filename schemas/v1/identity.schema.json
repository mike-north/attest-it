{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://attest-it.dev/schemas/v1/identity.schema.json",
  "title": "attest-it Identity Configuration",
  "description": "Local identity configuration schema for attest-it. Contains user identity and key management settings.",
  "$ref": "#/definitions/identity",
  "definitions": {
    "identity": {
      "type": "object",
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "string",
              "const": "1"
            },
            {
              "not": {}
            }
          ]
        },
        "activeIdentity": {
          "type": "string",
          "minLength": 1
        },
        "identities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string"
              },
              "github": {
                "type": "string"
              },
              "publicKey": {
                "type": "string",
                "minLength": 1
              },
              "privateKey": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "file"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["type", "path"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "keychain"
                      },
                      "service": {
                        "type": "string",
                        "minLength": 1
                      },
                      "account": {
                        "type": "string",
                        "minLength": 1
                      },
                      "keychain": {
                        "type": "string"
                      }
                    },
                    "required": ["type", "service", "account"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "1password"
                      },
                      "account": {
                        "type": "string"
                      },
                      "vault": {
                        "type": "string",
                        "minLength": 1
                      },
                      "item": {
                        "type": "string",
                        "minLength": 1
                      },
                      "field": {
                        "type": "string"
                      }
                    },
                    "required": ["type", "vault", "item"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "yubikey"
                      },
                      "encryptedKeyPath": {
                        "type": "string",
                        "minLength": 1
                      },
                      "slot": {
                        "type": "number",
                        "enum": [1, 2]
                      },
                      "serial": {
                        "type": "string"
                      }
                    },
                    "required": ["type", "encryptedKeyPath"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": ["name", "publicKey", "privateKey"],
            "additionalProperties": false
          }
        }
      },
      "required": ["activeIdentity", "identities"],
      "additionalProperties": false
    }
  }
}
