{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://attest-it.dev/schemas/v1/seals.schema.json",
  "title": "attest-it Seals File",
  "description": "Seals file schema for attest-it. Contains cryptographic signatures for gate attestations.",
  "$ref": "#/definitions/seals",
  "definitions": {
    "seals": {
      "type": "object",
      "properties": {
        "version": {
          "type": ["number", "string"],
          "enum": [1, "1"]
        },
        "seals": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "gateId": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]+$"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "sealedBy": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["gateId", "fingerprint", "timestamp", "sealedBy", "signature"],
            "additionalProperties": false
          }
        }
      },
      "required": ["version", "seals"],
      "additionalProperties": false
    }
  }
}
