{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://attest-it.dev/schemas/v1/policy.schema.json",
  "title": "attest-it Policy Configuration",
  "description": "Policy configuration schema for attest-it. Contains security-critical settings like team members, gates, and authorization rules.",
  "$ref": "#/definitions/policy",
  "definitions": {
    "policy": {
      "type": "object",
      "properties": {
        "version": {
          "type": ["number", "string"],
          "enum": [1, "1"]
        },
        "minVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?(\\+[\\w.]+)?$"
        },
        "settings": {
          "type": "object",
          "properties": {
            "maxAgeDays": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 30
            },
            "publicKeyPath": {
              "type": "string",
              "default": ".attest-it/pubkey.pem"
            },
            "attestationsPath": {
              "type": "string",
              "default": ".attest-it/attestations.json"
            },
            "sealsPath": {
              "type": "string",
              "default": ".attest-it/seals.json"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "team": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "github": {
                "type": "string",
                "minLength": 1
              },
              "publicKey": {
                "type": "string",
                "minLength": 1
              },
              "publicKeyAlgorithm": {
                "type": "string",
                "const": "ed25519"
              }
            },
            "required": ["name", "publicKey"],
            "additionalProperties": false
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "authorizedSigners": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "fingerprint": {
                "type": "object",
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "exclude": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["paths"],
                "additionalProperties": false
              },
              "maxAge": {
                "type": "string"
              }
            },
            "required": ["name", "description", "authorizedSigners", "fingerprint", "maxAge"],
            "additionalProperties": false
          }
        }
      },
      "required": ["version"],
      "additionalProperties": false
    }
  }
}
