{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/*/bin/**/*",
    "packages/*/*.config.ts",
    "*.config.ts",
    "*.config.js"
  ],
  "exclude": ["node_modules", "**/node_modules/**", "**/dist/**", "**/temp/**", "**/tsup.config.ts"]
}
