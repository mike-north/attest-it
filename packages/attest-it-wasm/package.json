{
  "name": "@attest-it/wasm",
  "description": "WebAssembly-backed core for attest-it — Rust core with JS host bridge",
  "version": "0.1.0",
  "author": "Mike North <michael.l.north@gmail.com>",
  "dependencies": {
    "tinyglobby": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "~22.19.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.13.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check": "pnpm check:typecheck",
    "check:typecheck": "tsc --noEmit",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "type": "module"
}
