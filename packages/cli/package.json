{
  "name": "@attest-it/cli",
  "version": "0.5.0",
  "author": "Mike North <michael.l.north@gmail.com>",
  "bin": {
    "attest": "./dist/bin/attest-it.js",
    "attest-it": "./dist/bin/attest-it.js"
  },
  "dependencies": {
    "@attest-it/core": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "@inquirer/prompts": "^7.0.0",
    "@pnpm/tabtab": "^0.5.4",
    "chromaterm": "^0.1.0",
    "commander": "^13.0.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "shell-quote": "^1.8.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "~22.19.3",
    "@types/react": "~18.3.0",
    "@types/shell-quote": "~1.7.5",
    "execa": "^9.6.1",
    "fixturify-project": "^7.1.3",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vitest": "^3.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "repository": "attest-it/attest-it",
  "scripts": {
    "build": "tsup",
    "check": "pnpm run check:eslint && pnpm run check:types",
    "check:eslint": "eslint src",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:manual": "tsx test/manual-test-runner.ts",
    "test:manual:1password": "tsx test/manual/scripts/1password-integration.ts",
    "test:manual:agent": "tsx test/manual-test-runner.ts --print-command",
    "test:manual:keychain": "tsx test/manual/scripts/keychain-integration.ts",
    "test:manual:visual": "tsx test/manual/scripts/visual-verification.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
