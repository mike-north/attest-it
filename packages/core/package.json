{
  "name": "@attest-it/core",
  "description": "Core functionality for attest-it",
  "version": "0.5.0",
  "author": "Mike North <michael.l.north@gmail.com>",
  "dependencies": {
    "canonicalize": "^2.0.0",
    "ms": "^2.1.3",
    "tinyglobby": "^0.2.0",
    "yaml": "^2.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ms": "~2.1.0",
    "@types/node": "~22.19.3",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vitest": "^3.0.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "attestation",
    "testing"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup && declaration-file-normalizer dist/index.d.ts",
    "check": "pnpm run check:api-report && pnpm run check:eslint && pnpm run check:types",
    "check:api-report": "api-extractor run",
    "check:eslint": "eslint .",
    "check:types": "tsc --noEmit",
    "generate:api-report": "api-extractor run --local",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
