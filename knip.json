{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreDependencies": ["@nx/js", "lint-staged", "@types/picomatch"],
  "ignoreBinaries": ["op"],
  "ignore": ["**/vitest.config.*", "**/test/fixtures/**", "**/fixtures/**"],
  "workspaces": {
    "packages/core": {
      "entry": ["test/**/*.test.ts", "test/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["test/**/*.test.ts", "test/**/*.ts"]
    },
    "packages/github-action": {
      "entry": ["test/**/*.test.ts", "test/**/*.ts"]
    }
  }
}
