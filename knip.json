{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreDependencies": ["@nx/js", "lint-staged", "@types/picomatch"],
  "ignoreBinaries": ["op", "act"],
  "ignore": [
    "**/vitest.config.*",
    "**/test/fixtures/**",
    "**/fixtures/**",
    "scratch/**",
    "**/placeholder.ts"
  ],
  "workspaces": {
    "packages/core": {
      "entry": ["test/**/*.test.ts", "test/**/*.ts"],
      "ignore": [
        "src/config/policy-schema.ts",
        "src/config/operational-schema.ts",
        "src/config/shared-schemas.ts",
        "src/config/index.ts"
      ]
    },
    "packages/attest-it-wasm": {
      "ignore": ["wasm/**"]
    },
    "packages/cli": {
      "entry": ["test/**/*.test.ts", "test/**/*.ts"]
    },
    "packages/github-action": {
      "entry": ["test/**/*.test.ts", "test/**/*.ts"]
    }
  }
}
